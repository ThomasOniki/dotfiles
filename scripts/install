#!/bin/sh

kernel="$(uname -s | tr '[:upper:]' '[:lower:]')"

if [ "$kernel" = "darwin" ] && [ -z "$(command -v brew)" ]; then
	echo 'Detected darwin but homebrew not found, do you want to install it? (y/N)'

	read -r install_brew
	if [ "$install_brew" = "y" ]; then
		echo "Installing homebrew..."
		/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
	fi
fi

root="$(dirname "$(readlink -f -- "$0")")/.."
. "$root/scripts/helpers.sh"

for module in "$@"; do
	if ! [ -d "$root/$module" ]; then
		echo "Module '$module' not found."
		continue
	fi

	if [ -f "$root/scripts/symlink-paths/$module.txt" ]; then
		while read -r src dst; do
			eval "try_ln '$root/$module/$src' $dst"
		done <"$root/scripts/symlink-paths/$module.txt"
	else
		try_ln "$root/$module" "${XDG_CONFIG_HOME:-$HOME/.config}/$module"
	fi

	if [ -x "$root/scripts/install-scripts/$module.sh" ]; then
		"$root/scripts/install-scripts/$module.sh"
	fi
	if [ -x "$root/scripts/install-scripts/$module-$kernel.sh" ]; then
		"$root/scripts/install-scripts/$module-$kernel.sh"
	fi
done
