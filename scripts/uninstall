#!/bin/sh

kernel="$(uname -s | tr '[:upper:]' '[:lower:]')"

root="$(dirname "$(readlink -f -- "$0")")/.."
. "$root/scripts/helpers.sh"

for module in "$@"; do
	if ! [ -d "$root/$module" ]; then
		echo "Module '$module' not found."
		continue
	fi

	if [ -f "$root/scripts/symlink-paths/$module.txt" ]; then
		while read -r src dst; do
			eval "try_revert_ln '$root/$module/$src' $dst"
		done <"$root/scripts/symlink-paths/$module.txt"
	else
		try_revert_ln "$root/$module" "$XDG_CONFIG_HOME/$module"
	fi

	if [ -x "$root/scripts/uninstall-scripts/$module.sh" ]; then
		"$root/scripts/uninstall-scripts/$module.sh"
	fi
	if [ -x "$root/scripts/uninstall-scripts/$module-$kernel.sh" ]; then
		"$root/scripts/uninstall-scripts/$module-$kernel.sh"
	fi
done
