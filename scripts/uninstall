#!/usr/bin/env bash

if [[ "$BASH_SOURCE" != "$0" ]]; then
	echo "run this file, don't source it."
	return
fi

cd "$(dirname "$BASH_SOURCE")"
cd ..

kernel="$(uname -s | tr '[:upper:]' '[:lower:]')"

source scripts/helpers.bash

for module in "$@"; do
	if ! [[ -d "./$module" ]]; then
		echo "Module '$module' not found."
		continue
	fi

	if [[ -f "scripts/symlink-paths/$module.txt" ]]; then
		while read src dst; do
			eval "try_revert_ln $src $dst"
		done <"scripts/symlink-paths/$module.txt"
	else
		try_revert_ln "$module" "$cfg_home/$module"
	fi

	if [[ -f "scripts/uninstall-scripts/$module.bash" ]]; then
		bash "scripts/uninstall-scripts/$module.bash"
	fi
	if [[ -f "scripts/uninstall-scripts/$module-$kernel.bash" ]]; then
		bash "scripts/uninstall-scripts/$module-$kernel.bash"
	fi
done
